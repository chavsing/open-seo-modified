# Hosted SaaS on your own Cloudflare account, served on your own domain.
# Copy to .env.saas in the repo root, fill it in, then run `pnpm deploy:saas`.
# Data lives in D1 on the same account; no Postgres server is needed.

# ---------- Required ----------

AUTH_MODE=hosted

# Bare hostname, no https://. Its zone must be on this Cloudflare account.
APP_DOMAIN=

# 32+ random characters. Signs sessions and encrypts stored Google tokens.
BETTER_AUTH_SECRET=

# Google sign-in. Hosted mode does not start without these. Authorized
# redirect URIs: https://<APP_DOMAIN>/api/auth/callback/google,
# /api/gsc/oauth/callback and /api/ga4/oauth/callback on the same domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Loops sends the verify-email and reset-password emails. Sign-in does not
# work without all three.
LOOPS_API_KEY=
LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=
LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=

# SEO data. Base64 of login:password, see docs/DATAFORSEO_API_KEY.md
DATAFORSEO_API_KEY=

# Billing. Use the live key (am_sk_live_...) only after the sandbox is tested.
AUTUMN_SECRET_KEY=
# Signing secret of the Autumn webhook pointing at
# https://<APP_DOMAIN>/api/autumn/webhook
AUTUMN_WEBHOOK_SECRET=

# The in-app AI agent and AI features. The hosted UI assumes it is set.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# ---------- Optional ----------

# Team invitation emails
# LOOPS_TRANSACTIONAL_INVITATION_ID=

# Captcha on sign-up. Set both or neither.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Product analytics and error capture
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Fallback renderer for the site audit "Render JavaScript" option
# CONTEXT_API_KEY=

# 32+ random characters. Needed to save Shopify crawler signatures.
# CRAWLER_ACCESS_SECRET=

# Never set BYPASS_EMAIL_VERIFICATION in production: anyone could sign up
# with an email they do not own and claim free credits.
