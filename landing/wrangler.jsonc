// Static landing page. Deploy from this folder with
// `npx wrangler deploy -c wrangler.jsonc`. The routes attach the client's root
// domain and www as custom domains, so no DNS records need adding by hand.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agsmaster-landing",
  "compatibility_date": "2025-09-02",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "agsmaster.com", "custom_domain": true },
    { "pattern": "www.agsmaster.com", "custom_domain": true },
  ],
}
